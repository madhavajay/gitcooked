---
import '../styles/global.css';
const {
  title = 'gitcooked',
  description = 'The most cooked GitHub committers, globally and by country.',
  og = '/og/global.jpg',
} = Astro.props;
const ogUrl = new URL(og, Astro.site ?? 'https://gitcooked.dev');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogUrl} />
  </head>
  <body>
    <nav class="site-nav">
      <a href="/" class="brand">gitcooked</a>
      <div class="links">
        <a href="/global">global</a>
        <a href="/#countries">countries</a>
        <a href="/network">network</a>
        <a href="/clusters">repos</a>
        <a href="/vouchrank">vouchrank</a>
        <a href="/vouched">vouched</a>
        <a href="/tokens">tokens</a>
        <a href="/u">am i ranked?</a>
        <a href="#" id="nav-auth"></a>
      </div>
    </nav>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      a fork of <a href="https://committers.top/" target="_blank" rel="noopener">committers.top</a>
      by <a href="https://github.com/ashkulz" target="_blank" rel="noopener">@ashkulz</a>
      — ranking data collected with his
      <a href="https://github.com/ashkulz/committers.top" target="_blank" rel="noopener">most-active-github-users-counter</a>
    </footer>
    <script>
      const ease = (t) => 1 - Math.pow(1 - t, 3);
      const animate = (el) => {
        const target = parseInt(el.textContent.replace(/[^0-9]/g, ''), 10);
        if (!target || target < 10) return;
        const prefix = el.textContent.match(/^[^\d]*/)[0];
        const start = performance.now();
        const dur = 900;
        const tick = (now) => {
          const t = Math.min(1, (now - start) / dur);
          el.textContent = prefix + Math.round(ease(t) * target).toLocaleString();
          if (t < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      };
      const seen = new WeakSet();
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (e.isIntersecting && !seen.has(e.target)) { seen.add(e.target); animate(e.target); }
        }
      });
      document.querySelectorAll('.stat .num').forEach((el) => {
        if (/^[#]?[\d,]+$/.test(el.textContent.trim())) io.observe(el);
      });

      // --- identity: sign in (OAuth when API is live, cookie fallback) + highlight my rows ---
      const API = 'https://api.gitcooked.dev';
      const getUser = () => document.cookie.match(/(?:^|;\s*)gc_user=([^;]+)/)?.[1] ?? null;
      const setUser = (login) => { document.cookie = `gc_user=${login}; path=/; max-age=${365 * 86400}`; };
      const navAuth = document.getElementById('nav-auth');

      // returning from OAuth: /u/{login}?claimed=1
      const params = new URLSearchParams(location.search);
      if (params.get('claimed') === '1') {
        const m = /^\/u\/([\w-]+)/.exec(location.pathname);
        if (m) setUser(m[1]);
      }

      function highlightMe() {
        const u = getUser()?.toLowerCase();
        if (!u) return;
        document.querySelectorAll('.rank-table td a[href]').forEach((a) => {
          const login = a.getAttribute('href')?.split('/').filter(Boolean).pop()?.toLowerCase();
          if (login === u) a.closest('tr')?.classList.add('me');
        });
      }
      window.gcUser = getUser;
      window.gcHighlightMe = highlightMe;

      function renderAuth() {
        const u = getUser();
        navAuth.textContent = u ? `@${u}` : 'sign in';
        navAuth.href = u ? `/u/${u}` : '#';
        navAuth.classList.toggle('nav-me', !!u);
      }
      navAuth.addEventListener('click', async (e) => {
        if (getUser()) return;
        e.preventDefault();
        try {
          const ctrl = new AbortController();
          setTimeout(() => ctrl.abort(), 1500);
          const r = await fetch(`${API}/api/health`, { signal: ctrl.signal });
          if (r.ok) { location.href = `${API}/api/auth/login`; return; }
        } catch { /* api not deployed yet */ }
        const login = prompt('your GitHub username? (full GitHub sign-in arrives when the API goes live)');
        if (login?.trim()) {
          setUser(login.trim());
          renderAuth();
          highlightMe();
        }
      });
      renderAuth();
      highlightMe();
    </script>
  </body>
</html>
