---
import Layout from '../layouts/Layout.astro';
import reposTop from '../data/repos_top.json';

const av = (u, s) => u.avatarUrl ? `${u.avatarUrl}${u.avatarUrl.includes('?') ? '&' : '?'}s=${s}` : '';
---
<Layout title="cracked repos — gitcooked" description="The repos where the most active GitHub committers collide.">
  <h1 class="glow">cracked repos</h1>
  <p class="sub">
    where the top {reposTop.indexedUsers.toLocaleString()} ranked committers collide — repos shared by 2+ ranked devs.
  </p>

  <div class="tabs">
    <button class="tab active" data-sort="members"># ranked contributors</button>
    <button class="tab" data-sort="vouch">trust score</button>
  </div>

  <table class="rank-table" id="repos-table">
    <thead><tr><th>#</th><th>repo</th><th>lang</th><th>ranked devs</th><th style="text-align:right" id="score-col">devs</th></tr></thead>
    <tbody></tbody>
  </table>

  <script type="application/json" id="repos-data" set:html={JSON.stringify(reposTop.repos)}></script>
  <script>
    const repos = JSON.parse(document.getElementById('repos-data').textContent);
    const tbody = document.querySelector('#repos-table tbody');
    const scoreCol = document.getElementById('score-col');
    const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    const av = (u, s) => u.avatarUrl ? `${u.avatarUrl}${u.avatarUrl.includes('?') ? '&' : '?'}s=${s}` : '';

    function show(sort) {
      const sorted = [...repos].sort((a, b) =>
        sort === 'vouch' ? b.vouchScore - a.vouchScore : b.memberCount - a.memberCount || b.vouchScore - a.vouchScore
      );
      scoreCol.textContent = sort === 'vouch' ? 'trust score' : 'devs';
      tbody.innerHTML = sorted.map((r, i) => `
        <tr class="${i < 10 ? `t10 r${i < 3 ? i + 1 : ''}` : ''}">
          <td class="rank">${i + 1}</td>
          <td><a href="https://github.com/${esc(r.repo)}" target="_blank" rel="noopener">${esc(r.repo)}</a>
            <div class="name" style="color:var(--muted);font-size:12px">★ ${r.stars.toLocaleString()}</div></td>
          <td class="meta">${r.lang ? `<span class="chip">${esc(r.lang)}</span>` : ''}</td>
          <td><span class="faces-row">${r.members.slice(0, 8).map((m) =>
            `<a href="/network?repo=${encodeURIComponent(r.repo)}" title="${esc(m.login)} · #${m.rank} · vouch ${m.vouch}"><img src="${esc(av(m, 48))}" width="26" height="26" loading="lazy"/></a>`
          ).join('')}</span></td>
          <td class="num">${sort === 'vouch' ? r.vouchScore.toLocaleString() : r.memberCount}</td>
        </tr>`).join('');
    }

    document.querySelectorAll('[data-sort]').forEach((b) =>
      b.addEventListener('click', () => {
        document.querySelectorAll('[data-sort]').forEach((x) => x.classList.toggle('active', x === b));
        show(b.dataset.sort);
      })
    );
    show('members');
  </script>
</Layout>

<style is:global>
  .faces-row img {
    width: 26px; height: 26px; border-radius: 50%; border: 2px solid var(--bg);
    margin-right: -7px; background: var(--bg-soft); vertical-align: middle;
  }
  .faces-row a:hover img { border-color: var(--cyan); transform: scale(1.15); }
</style>
