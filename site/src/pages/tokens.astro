---
import Layout from '../layouts/Layout.astro';
import community from '../data/community.json';

const byUser = {};
for (const row of community.aiUsage) {
  const u = (byUser[row.login] ??= { login: row.login, total: 0, cost: 0, providers: {} });
  const t = row.inputTokens + row.outputTokens;
  u.total += t;
  u.cost += row.costUSD ?? 0;
  u.providers[row.provider] = (u.providers[row.provider] ?? 0) + t;
}
const board = Object.values(byUser).sort((a, b) => b.total - a.total).slice(0, 100);
const fmt = (n) => (n >= 1e9 ? (n / 1e9).toFixed(1) + 'B' : n >= 1e6 ? (n / 1e6).toFixed(1) + 'M' : n.toLocaleString());
---
<Layout title="token maxxing — gitcooked" description="Self-reported AI token usage leaderboard. For fun. Obviously.">
  <h1 class="glow">token maxxing</h1>
  <p class="sub">
    self-reported AI token burn, for bragging rights only — this never touches the real rankings.
    checked {community.checked.toLocaleString()} profile repos, {community.found} opted in so far.
  </p>

  {board.length === 0 ? (
    <div class="empty-state">
      <p>nobody has published their token stats yet. be the first:</p>
      <ol>
        <li>create <code>gitcooked.json</code> in your profile repo (<code>github.com/YOU/YOU</code>)</li>
        <li>add your usage (tools like codexbar can give you the numbers):</li>
      </ol>
      <pre class="embed-snippet"><code>{`{
  "ai_usage": [
    { "provider": "anthropic", "period": "2026-05",
      "input_tokens": 120000000, "output_tokens": 4200000 }
  ]
}`}</code></pre>
      <p>it gets picked up on the next index run. <a href="https://github.com/madhavajay/gitcooked/blob/main/docs/gitcooked-json-spec.md">full spec →</a></p>
    </div>
  ) : (
    <table class="rank-table">
      <thead><tr><th>#</th><th>user</th><th>providers</th><th style="text-align:right">burn</th><th style="text-align:right">tokens</th></tr></thead>
      <tbody>
        {board.map((u, i) => (
          <tr class={i < 10 ? `t10 r${i < 3 ? i + 1 : ''}` : ''}>
            <td class="rank">{i + 1}</td>
            <td><a href={`/u/${u.login}`}>{u.login}</a></td>
            <td class="meta">{Object.entries(u.providers).map(([p, t]) => <span class="chip">{p} {fmt(t)}</span>)}</td>
            <td class="num">{u.cost > 0 ? `$${Math.round(u.cost).toLocaleString()}` : '—'}</td>
            <td class="num">{fmt(u.total)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  )}
</Layout>

<style>
  .empty-state {
    border: 1px dashed var(--line); border-radius: 16px; padding: 24px 28px;
    background: var(--panel); max-width: 640px;
  }
  .embed-snippet {
    background: var(--bg-soft); border: 1px solid var(--line); border-radius: 10px;
    padding: 12px 16px; overflow-x: auto; font-size: 13px; color: var(--cyan);
  }
</style>
