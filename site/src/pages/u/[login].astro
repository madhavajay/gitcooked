---
import Layout from '../../layouts/Layout.astro';
import global from '../../data/global.json';
import community from '../../data/community.json';
import profilesMeta from '../../data/profiles_meta.json';

export async function getStaticPaths() {
  const files = import.meta.glob('../../data/locations/*.json', { eager: true });
  const localRanks = {};
  for (const loc of Object.values(files)) {
    if (loc.slug === 'worldwide') continue;
    for (const u of loc.modes.commits) {
      (localRanks[u.login] ??= []).push({ slug: loc.slug, title: loc.title, rank: u.rank });
    }
  }
  const rankIn = (mode, login) => {
    const u = mode.find((x) => x.login === login);
    return u ? u.rank : null;
  };
  return global.modes.commits.slice(0, 1000).map((u) => ({
    params: { login: u.login },
    props: {
      user: u,
      ranks: {
        commits: u.rank,
        contributions: rankIn(global.modes.contributions, u.login),
        all: rankIn(global.modes.all, u.login),
      },
      local: (localRanks[u.login] ?? []).sort((a, b) => a.rank - b.rank),
      vouchedBy: community.vouches[u.login] ?? [],
      repoVouches: community.repoVouches?.[u.login] ?? [],
      denounced: community.denounced?.[u.login] ?? [],
      socials: { ...(profilesMeta[u.login]?.socials ?? {}), ...(community.socials[u.login] ?? {}) },
      email: profilesMeta[u.login]?.email ?? null,
    },
  }));
}

const { user, ranks, local, vouchedBy, repoVouches, denounced, socials, email } = Astro.props;
const av = user.avatarUrl ? `${user.avatarUrl}${user.avatarUrl.includes('?') ? '&' : '?'}s=240` : '';
---
<Layout title={`${user.login} — gitcooked`} og={`/og/u/${user.login}.jpg`} description={`${user.login} is ranked #${ranks.commits} globally on gitcooked.`}>
  <div class="profile-hero">
    <img class="profile-avatar" src={av} alt={user.login} />
    <div>
      <h1 class="glow" style="margin:0">{user.login}</h1>
      <p class="sub" style="margin:4px 0 0">{user.name}{user.company ? ` · ${user.company}` : ''}</p>
      <a href={`https://github.com/${user.login}`} target="_blank" rel="noopener" class="mono">github.com/{user.login} ↗</a>
      · <a href={`/network?u=${user.login}`} class="mono">view network →</a>
      <span id="distance-link"></span>
      <div class="contact-row">
        {email && <a class="chip" href={`mailto:${email}`}>✉ {email}</a>}
        {Object.entries(socials).map(([k, v]) => <a class="chip" href={v} target="_blank" rel="noopener">{k}</a>)}
      </div>
    </div>
  </div>

  <div class="stats-row">
    <div class="stat"><div class="num">#{ranks.commits}</div><div class="label">global · commits</div></div>
    {ranks.contributions && <div class="stat"><div class="num">#{ranks.contributions}</div><div class="label">global · contributions</div></div>}
    {ranks.all && <div class="stat"><div class="num">#{ranks.all}</div><div class="label">global · incl. private</div></div>}
    <div class="stat"><div class="num">{user.contributions.toLocaleString()}</div><div class="label">contributions / yr</div></div>
  </div>

  {local.length > 0 && (
    <>
      <h2 class="section-title">local rankings</h2>
      <div class="stats-row">
        {local.map((l) => (
          <a class="stat" href={`/${l.slug}`} style="text-decoration:none">
            <div class="num">#{l.rank}</div>
            <div class="label">{l.title}</div>
          </a>
        ))}
      </div>
    </>
  )}

  {user.organizations.length > 0 && (
    <>
      <h2 class="section-title">organizations</h2>
      <p>{user.organizations.map((o) => <span class="chip">{o}</span>)}</p>
    </>
  )}

  {(vouchedBy.length > 0 || repoVouches.length > 0) && (
    <>
      <h2 class="section-title">vouched for by {vouchedBy.length + repoVouches.length} {vouchedBy.length + repoVouches.length > 1 ? 'devs & projects' : 'project'}</h2>
      <p>
        {vouchedBy.map((v) => <a class="chip" href={`/u/${v.voucher}`} title={v.note}>{v.voucher}</a>)}
        {repoVouches.map((v) => <a class="chip chip-good" href={`https://github.com/${v.repo}`} target="_blank" rel="noopener" title={v.note}>📦 {v.repo}</a>)}
      </p>
    </>
  )}

  {denounced.length > 0 && (
    <>
      <h2 class="section-title" style="color:#ff8c8c">⚠ denounced by {denounced.length} project{denounced.length > 1 ? 's' : ''}</h2>
      <p>
        {denounced.map((v) => <a class="chip chip-bad" href={`https://github.com/${v.repo}`} target="_blank" rel="noopener" title={v.note}>{v.repo}</a>)}
        <span class="sub" style="display:block;margin-top:6px">from public <span class="mono">VOUCHED.td</span> files — <a href="/denounced">about denouncements</a></span>
      </p>
    </>
  )}

  <div id="follower-web-section" class="hidden">
    <h2 class="section-title" id="web">follower web</h2>
    <p class="sub" id="web-sub"></p>
    <div id="follower-web"></div>
  </div>

  <div id="claimed-extras"></div>

  <h2 class="section-title">badge</h2>
  <p class="sub">put your live rank on your README or website:</p>
  <pre class="embed-snippet"><code>[![gitcooked](https://api.gitcooked.dev/badge/{user.login}.svg)](https://gitcooked.dev/u/{user.login})</code></pre>
  {local.length > 0 && (
    <pre class="embed-snippet"><code>[![gitcooked](https://api.gitcooked.dev/badge/{user.login}.svg?scope={local[0].slug})](https://gitcooked.dev/{local[0].slug})</code></pre>
  )}

  <p class="sub" style="margin-top:30px">
    is this you? <a href={`https://api.gitcooked.dev/api/auth/login`}>claim this profile</a> to add socials &amp; vouch for other devs.
  </p>

  <script>
    const login = location.pathname.split('/').filter(Boolean).pop();
    const API = 'https://api.gitcooked.dev';

    // degrees-of-separation link when signed in (item: distance from you)
    const me = document.cookie.match(/(?:^|;\s*)gc_user=([^;]+)/)?.[1];
    if (me && me.toLowerCase() !== login.toLowerCase()) {
      document.getElementById('distance-link').innerHTML =
        ` · <a class="mono" href="/network?u=${me}&path=${login}">degrees from you →</a>`;
    }
    // flat follower web: phyllotaxis spiral, best-vouched closest to the center
    fetch(`/data/followers/${login}.json`)
      .then((r) => (r.ok ? r.json() : null))
      .then((web) => {
        if (!web || !web.followers.length) return;
        const section = document.getElementById('follower-web-section');
        section.classList.remove('hidden');
        const outside = web.totalFollowers != null ? web.totalFollowers - web.inNetwork : null;
        document.getElementById('web-sub').textContent =
          `${web.inNetwork.toLocaleString()} ranked devs follow ${login}` +
          (outside != null && outside > 0 ? ` (+${outside.toLocaleString()} followers outside the rankings)` : '') +
          ` — bigger & closer to the center = higher vouchrank. click to explore.`;
        const fs = web.followers;
        const W = Math.min(960, document.getElementById('follower-web').clientWidth || 960);
        const GA = Math.PI * (3 - Math.sqrt(5));
        const spread = 30;
        const maxR = spread * Math.sqrt(fs.length) + 70;
        const H = Math.min(2 * maxR + 60, 900);
        const cx = W / 2, cy = H / 2;
        const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
        const av = (u, s) => u.avatarUrl ? `${u.avatarUrl}${u.avatarUrl.includes('?') ? '&' : '?'}s=${s}` : '';
        const me = document.querySelector('.profile-avatar')?.src ?? '';
        const nodes = fs.map((f, i) => {
          const r = spread * Math.sqrt(i + 1.5);
          const a = i * GA;
          const size = 14 + ((f.score ?? 0) / 1000) * 30; // scaled by vouchrank score
          return { f, x: cx + r * Math.cos(a), y: cy + (r * Math.sin(a) * (H / (2 * maxR))), size };
        });
        document.getElementById('follower-web').innerHTML = `
          <svg viewBox="0 0 ${W} ${H}" width="100%" height="${H}">
            ${nodes.map((n) => `<line x1="${cx}" y1="${cy}" x2="${n.x}" y2="${n.y}" stroke="#8a5cff" stroke-opacity="${Math.max(0.04, 0.3 - n.size / 200)}" stroke-width="1"/>`).join('')}
            ${nodes.map((n) => `
              <a href="${n.f.rank && n.f.rank <= 1000 ? `/u/${esc(n.f.login)}` : `https://github.com/${esc(n.f.login)}`}">
                <image href="${esc(av(n.f, 64))}" x="${n.x - n.size / 2}" y="${n.y - n.size / 2}" width="${n.size}" height="${n.size}"
                  style="clip-path:circle(50%)" loading="lazy"/>
                ${n.f.score != null ? `<text x="${n.x}" y="${n.y + n.size / 2 + 8}" text-anchor="middle"
                  font-family="ui-monospace,Menlo,monospace" font-size="${Math.max(7, n.size / 4)}"
                  fill="#2ee6ff" fill-opacity="0.85">${n.f.score}</text>` : ''}
                <title>${esc(n.f.login)}${n.f.rank ? ` · contrib #${n.f.rank.toLocaleString()}` : ''}${n.f.score != null ? ` · vouch ${n.f.score}` : ''}</title>
              </a>`).join('')}
            <circle cx="${cx}" cy="${cy}" r="34" fill="#06070e" stroke="#b6ff2e" stroke-width="2.5"/>
            <image href="${me}" x="${cx - 31}" y="${cy - 31}" width="62" height="62" style="clip-path:circle(50%)"/>
          </svg>`;
      })
      .catch(() => {});

    fetch(`${API}/api/profile/${login}`)
      .then((r) => (r.ok ? r.json() : null))
      .then((p) => {
        if (!p) return;
        const el = document.getElementById('claimed-extras');
        let html = '';
        const socials = Object.entries(p.socials ?? {});
        if (socials.length) {
          html += '<h2 class="section-title">links</h2><p>' +
            socials.map(([k, v]) => `<a class="chip" href="${v}" target="_blank" rel="noopener">${k}</a>`).join(' ') + '</p>';
        }
        if (p.vouchedBy?.length) {
          html += `<h2 class="section-title">vouched for by ${p.vouchedBy.length} dev${p.vouchedBy.length > 1 ? 's' : ''}</h2><p>` +
            p.vouchedBy.map((v) => `<a class="chip" href="/u/${v.voucher}">${v.voucher}</a>`).join(' ') + '</p>';
        }
        el.innerHTML = html;
      })
      .catch(() => {});
  </script>
</Layout>

<style>
  .embed-snippet {
    background: var(--bg-soft); border: 1px solid var(--line); border-radius: 10px;
    padding: 12px 16px; overflow-x: auto; font-size: 13px; color: var(--cyan);
  }
  .contact-row { margin-top: 8px; display: flex; flex-wrap: wrap; gap: 4px; }
  #follower-web {
    border: 1px solid var(--line); border-radius: 16px; overflow: hidden;
    background: radial-gradient(circle at 50% 50%, #8a5cff0d, transparent 70%), var(--bg-soft);
    box-shadow: 0 0 30px #8a5cff14;
  }
  #follower-web image { transition: transform .12s; transform-origin: center; transform-box: fill-box; }
  #follower-web a:hover image { transform: scale(1.5); }
</style>
