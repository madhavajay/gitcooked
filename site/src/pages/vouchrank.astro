---
import Layout from '../layouts/Layout.astro';
import top from '../data/vouchrank_top.json';

const initial = top.slice(0, 50);
const av = (u, s) => u.avatarUrl ? `${u.avatarUrl}${u.avatarUrl.includes('?') ? '&' : '?'}s=${s}` : '';
---
<Layout title="VouchRank — gitcooked" description="A PageRank-style trust score over the GitHub follow graph. Who do the most cooked devs actually pay attention to?">
  <h1 class="glow">VouchRank</h1>
  <p class="sub">
    follows are vouches. PageRank over who-follows-whom among the most active committers —
    attention from highly-ranked devs is worth more, and it flows through the graph,
    so bot followers that nobody follows are worth ~nothing. <a href="#how">how it works ↓</a>
  </p>

  <input class="filter-box" data-filter type="search" placeholder="find a github user…" autocomplete="off" />
  <div id="vr-result"></div>

  <table class="rank-table" data-table>
    <thead>
      <tr>
        <th>#</th><th>user</th><th>company</th><th>followers</th><th>contrib rank</th>
        <th style="text-align:right">score</th>
      </tr>
    </thead>
    <tbody>
      {initial.map((u) => (
        <tr class={u.vrRank <= 10 ? `t10 r${u.vrRank <= 3 ? u.vrRank : ''}` : ''}>
          <td class="rank">{u.vrRank}</td>
          <td><div class="who">
            <img class="avatar" src={av(u, u.vrRank <= 10 ? 96 : 64)} alt={u.login} loading="lazy" />
            <div>
              <a href={`/vouchrank?u=${u.login}`}>{u.login}</a>
              <div class="name">{u.name}</div>
            </div>
          </div></td>
          <td class="meta">{u.company}</td>
          <td class="meta">{u.followers != null ? u.followers.toLocaleString() : `${u.inNetwork.toLocaleString()} in-network`}</td>
          <td class="meta">{u.contribRank ? `#${u.contribRank.toLocaleString()}` : '—'}</td>
          <td class="num">{u.score}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <button class="btn-more" data-more>show more</button>

  <h2 class="section-title" id="how">how it's calculated</h2>
  <div class="vr-method">
    <ol>
      <li>we crawl the follow graph of the ~38k ranked committers (top 1000 global + top 25 of every country, then their networks)</li>
      <li>every follow is a directed edge: <span class="mono">you → person you follow</span> = a vouch</li>
      <li>PageRank (damping 0.85) runs over that graph, with the restart vector weighted by contribution ranking (<span class="mono">1/√rank</span>) — so attention from top committers seeds more trust</li>
      <li>your score is what flows to you, log-scaled to 0–1000 against the #1 dev</li>
    </ol>
    <p class="sub">you can't game it with follower bots: a vouch only carries weight if the voucher is vouched for. share your score: <span class="mono">gitcooked.dev/vouchrank?u=YOU</span></p>
  </div>

  <script type="application/json" data-vr-initial set:html={JSON.stringify(initial)}></script>
  <script>
    const result = document.getElementById('vr-result');
    const tbody = document.querySelector('[data-table] tbody');
    const moreBtn = document.querySelector('[data-more]');
    const filter = document.querySelector('[data-filter]');

    let loaded = JSON.parse(document.querySelector('[data-vr-initial]').textContent);
    let shown = 50;
    let total = null;
    let nextPage = 0; // page-0 includes the SSR rows; we dedupe by slicing
    let lookup = null; // compact map for any-user lookup

    const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    const fmt = (n) => (n == null ? '—' : n.toLocaleString());
    const av = (u, s) => u.avatarUrl ? `${u.avatarUrl}${u.avatarUrl.includes('?') ? '&' : '?'}s=${s}` : '';

    function row(u) {
      const cls = u.vrRank <= 10 ? `t10 r${u.vrRank <= 3 ? u.vrRank : ''}` : '';
      return `<tr class="${cls}">
        <td class="rank">${u.vrRank}</td>
        <td><div class="who">
          <img class="avatar" src="${esc(av(u, u.vrRank <= 10 ? 96 : 64))}" loading="lazy" />
          <div><a href="/vouchrank?u=${esc(u.login)}">${esc(u.login)}</a>
          <div class="name">${esc(u.name)}</div></div>
        </div></td>
        <td class="meta">${esc(u.company)}</td>
        <td class="meta">${u.followers != null ? fmt(u.followers) : `${fmt(u.inNetwork)} in-network`}</td>
        <td class="meta">${u.contribRank ? `#${fmt(u.contribRank)}` : '—'}</td>
        <td class="num">${u.score}</td>
      </tr>`;
    }

    async function ensureMeta() {
      if (total == null) {
        const m = await fetch('/data/vouchrank_pages/meta.json').then((r) => r.json()).catch(() => ({ total: loaded.length }));
        total = m.total;
      }
    }

    function update() {
      tbody.innerHTML = loaded.slice(0, shown).map(row).join('');
      moreBtn.classList.toggle('hidden', total != null && shown >= total);
      moreBtn.textContent = `show more (${Math.min(shown, total ?? loaded.length).toLocaleString()} of ${(total ?? loaded.length).toLocaleString()})`;
      window.gcHighlightMe?.();
    }

    moreBtn.addEventListener('click', async () => {
      await ensureMeta();
      shown += 100;
      while (shown > loaded.length && loaded.length < total) {
        const res = await fetch(`/data/vouchrank_pages/page-${nextPage}.json`);
        if (!res.ok) break;
        const page = await res.json();
        loaded = loaded.concat(page.filter((u) => u.vrRank > loaded.length));
        nextPage++;
      }
      update();
    });

    async function showCard(login) {
      if (!lookup) lookup = await fetch('/data/vouchrank.json').then((r) => r.json()).catch(() => null);
      if (!lookup) return false;
      const hit = Object.entries(lookup.users).find(([l]) => l.toLowerCase() === login.toLowerCase());
      if (!hit) {
        result.innerHTML = `<p class="sub">${esc(login)} isn't in the crawled graph yet — it grows daily. <a href="/u">check your contribution rank →</a></p>`;
        return false;
      }
      const [name, [vrRank, score, followers, following, contribRank, indeg, depths, endorsers]] = hit;
      const pct = Math.max(1, Math.round((vrRank / Object.keys(lookup.users).length) * 100));
      history.replaceState(null, '', `?u=${name}`);
      const DCOLORS = ['#7b84ad', '#2ee6ff', '#8a5cff', '#ff3df2', '#ffb02e', '#1c2140'];
      const DLABELS = ['your seed (contribution rank)', '1st degree — direct followers', '2nd degree', '3rd degree', '4th degree', 'deeper echoes'];
      let breakdown = '';
      if (depths) {
        const pts = depths.map((pm) => score * pm / 1000);
        breakdown = `
          <div class="vr-bar">${depths.map((pm, i) => pm > 2 ? `<span style="width:${pm / 10}%;background:${DCOLORS[i]}"></span>` : '').join('')}</div>
          <div class="vr-legend">${depths.map((pm, i) => pm > 2 ? `
            <span><i style="background:${DCOLORS[i]}"></i>${DLABELS[i]}: <b>${pts[i] < 1 ? '<1' : Math.round(pts[i])} pts</b> (${(pm / 10).toFixed(0)}%)</span>` : '').join('')}
          </div>
          ${endorsers?.length ? `<p class="sub">biggest vouches: ${endorsers.map(([l, pm]) => `<a href="?u=${esc(l)}">@${esc(l)}</a> <b class="mono" style="color:var(--cyan)">+${(pm / 10).toFixed(1)}%</b>`).join(' · ')}</p>` : ''}`;
      }
      result.innerHTML = `
        <div class="stats-row" style="margin-top:22px">
          <div class="stat"><div class="num">${score}</div><div class="label">vouchrank score</div></div>
          <div class="stat"><div class="num">#${fmt(vrRank)}</div><div class="label">of ${fmt(Object.keys(lookup.users).length)} · top ${pct}%</div></div>
          <div class="stat"><div class="num">${followers != null ? fmt(followers) : fmt(indeg)}</div><div class="label">${followers != null ? 'followers' : 'in-network followers'}</div></div>
          ${following != null ? `<div class="stat"><div class="num">${fmt(following)}</div><div class="label">following</div></div>` : ''}
          ${contribRank ? `<div class="stat"><div class="num">#${fmt(contribRank)}</div><div class="label">contribution rank</div></div>` : ''}
        </div>
        ${breakdown}
        ${followers == null ? `<p class="sub">this profile hasn't been crawled yet — the score comes from ${fmt(indeg)} known in-network followers.</p>` : ''}
        <p>${contribRank && contribRank <= 1000 ? `<a href="/u/${esc(name)}#web">follower web →</a> · ` : ''}<a href="/network?u=${esc(name)}">3D network →</a></p>`;
      return true;
    }

    const debounce = (fn, ms) => { let t; return (...a) => { clearTimeout(t); t = setTimeout(() => fn(...a), ms); }; };
    filter.addEventListener('input', debounce(async () => {
      const q = filter.value.trim().toLowerCase();
      if (!q) { result.innerHTML = ''; update(); return; }
      const matches = loaded.filter((u) => u.login.toLowerCase().includes(q) || (u.name || '').toLowerCase().includes(q));
      tbody.innerHTML = matches.slice(0, 50).map(row).join('');
      moreBtn.classList.add('hidden');
      if (q.length >= 2) await showCard(q);
    }, 250));

    const u = new URLSearchParams(location.search).get('u');
    if (u) { filter.value = u; showCard(u); }
    update();
  </script>

  <style is:global>
    .vr-bar {
      display: flex; height: 14px; border-radius: 999px; overflow: hidden;
      border: 1px solid var(--line); margin: 6px 0 10px; max-width: 720px;
    }
    .vr-bar span { display: block; height: 100%; }
    .vr-legend { display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: 12px; color: var(--muted); margin-bottom: 10px; }
    .vr-legend i { display: inline-block; width: 9px; height: 9px; border-radius: 2px; margin-right: 6px; }
    .vr-legend b { color: var(--text); }
  </style>
  <style>
    .vr-method {
      border: 1px solid var(--line); border-radius: 16px; padding: 8px 26px 16px;
      background: var(--panel); max-width: 720px;
    }
    .vr-method li { margin: 8px 0; color: var(--text); }
  </style>
</Layout>
