    }
    .slider-label span { color: var(--cyan); }
    input[type='range'] { accent-color: #8a5cff; width: 140px; }
    .chip-x { cursor: pointer; background: #8a5cff22; border-color: var(--violet); color: var(--text); font-family: inherit; font-size: 11px; }
    .chip-x:hover { background: #ff3df222; border-color: var(--magenta); }
  </style>
</Layout>
