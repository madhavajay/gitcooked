---
import Layout from '../layouts/Layout.astro';
---
<Layout title="the network — gitcooked" description="The follower network of the most active GitHub committers — degrees of separation, visualized.">
  <h1 class="glow">the network</h1>
  <p class="sub">
    who follows whom among the most cooked devs on earth.
    <span id="net-meta"></span>
  </p>

  <div class="net-controls">
    <input class="filter-box" id="net-user" type="search" placeholder="center on user… (ego view)" autocomplete="off" />
    <input class="filter-box" id="net-path" type="search" placeholder="…find path to user (kevin bacon mode)" autocomplete="off" />
    <button class="tab" id="net-geo">🌍 geo layout</button>
    <button class="tab" id="net-reset">reset</button>
  </div>
  <div class="net-controls">
    <input class="filter-box" id="net-country" list="country-list" placeholder="filter countries… (add 1+)" autocomplete="off" />
    <datalist id="country-list"></datalist>
    <span id="country-chips"></span>
    <label class="slider-label">top
      <input type="number" class="num-box" id="rank-cap" min="10" max="8000" step="10" value="100" /> by rank
    </label>
    <label class="slider-label">min
      <input type="number" class="num-box" id="min-followers" min="0" step="10" value="100" /> followers
    </label>
    <input class="filter-box" id="net-repo" list="repo-list" placeholder="repo contributors…" autocomplete="off" style="max-width:200px" />
    <datalist id="repo-list"></datalist>
    <button class="tab" id="net-loners" title="hide nodes with no visible links in the current view">hide unlinked</button>
    <label class="slider-label">right-click removes
      <select id="hide-hops" class="tab" style="cursor:pointer">
        <option value="0">node</option>
        <option value="1">+1 hop</option>
        <option value="2">+2 hops</option>
      </select>
    </label>
    <button class="tab hidden" id="net-unhide"></button>
  </div>
  <p class="sub" id="net-status"></p>
  <div id="net-sim" class="hidden" style="color:var(--magenta);font-weight:700;letter-spacing:2px">⚠ SIMULATED DATA — for UI testing only</div>

  <div id="graph-wrap">
    <div id="graph"></div>
    <div id="stats-panel" class="hidden">
      <button id="stats-close">×</button>
      <img id="stats-avatar" />
      <div id="stats-body"></div>
    </div>
  </div>

  <script>
    import ForceGraph3D from '3d-force-graph';
    import * as THREE from 'three';
    import countries from '../geo/countries.json';
    import land from '../geo/land.json';

    const REGION_COLORS = {
      'Africa': '#b6ff2e', 'Asia': '#ff3df2', 'Europe': '#2ee6ff',
      'North America': '#8a5cff', 'South America': '#ffb02e',
      'Oceania': '#2eff9e', 'Middle East': '#ff5c5c',
    };
    const FADE_COLOR = 'rgba(90,98,140,0.18)';

    const el = document.getElementById('graph');
    const status = document.getElementById('net-status');
    let DATA = null;
    let adj = null;
    let geoMode = false;
    let Graph = null;
    let highlightSet = new Set(); // bright (path / ego center)
    let focusSet = null; // when set, everything outside fades

    const byLogin = new Map();

    function buildAdj() {
      adj = new Map(DATA.nodes.map((n) => [n.id, []]));
      for (const [a, b] of DATA.links) { adj.get(a).push(b); adj.get(b).push(a); }
    }

    function bfsPath(srcId, dstId) {
      const prev = new Map([[srcId, null]]);
      let q = [srcId];
      while (q.length) {
        const next = [];
        for (const n of q) {
          if (n === dstId) {
            const path = [];
            for (let c = dstId; c !== null; c = prev.get(c)) path.push(c);
            return path.reverse();
          }
          for (const m of adj.get(n)) if (!prev.has(m)) { prev.set(m, n); next.push(m); }
        }
        q = next;
      }
      return null;
    }

    function egoSet(id, hops = 2, cap = 600) {
      const dist = new Map([[id, 0]]);
      let q = [id];
      for (let d = 1; d <= hops && q.length; d++) {
        const next = [];
        for (const n of q) for (const m of adj.get(n)) {
          if (!dist.has(m) && dist.size < cap) { dist.set(m, d); next.push(m); }
        }
        q = next;
      }
      return dist;
    }

    // ---- avatar faces: async textures, loaded on zoom proximity ----

    const texCache = new Map(); // login -> Texture | 'loading' | 'failed'
    let refreshQueued = false;

    function scheduleRefresh() {
      if (refreshQueued) return;
      refreshQueued = true;
      setTimeout(() => {
        refreshQueued = false;
        Graph.nodeThreeObject(Graph.nodeThreeObject()); // re-evaluate node objects
      }, 400);
    }

    function flagEmoji(slug) {
      const iso = countries[slug]?.iso2;
      if (!iso || iso.length !== 2) return null;
      return String.fromCodePoint(...[...iso.toUpperCase()].map((c) => 0x1f1e6 + c.charCodeAt(0) - 65));
    }

    function circleTexture(img, n) {
      const S = 96;
      const c = document.createElement('canvas');
      c.width = c.height = S;
      const ctx = c.getContext('2d');
      ctx.save();
      ctx.beginPath();
      ctx.arc(S / 2, S / 2, S / 2 - 3, 0, Math.PI * 2);
      ctx.closePath();
      ctx.clip();
      ctx.drawImage(img, 0, 0, S, S);
      ctx.restore();
      ctx.beginPath();
      ctx.arc(S / 2, S / 2, S / 2 - 3, 0, Math.PI * 2);
      ctx.strokeStyle = '#2ee6ff';
      ctx.lineWidth = 4;
      ctx.stroke();
      const flag = flagEmoji(n.country);
      if (flag) {
        ctx.font = '28px "Apple Color Emoji", "Noto Color Emoji", sans-serif';
        ctx.textAlign = 'right';
        ctx.textBaseline = 'bottom';
        ctx.fillText(flag, S - 2, S + 2);
      }
      const tex = new THREE.CanvasTexture(c);
      tex.colorSpace = THREE.SRGBColorSpace;
      return tex;
    }

    function loadFace(n) {
      if (!n.avatarUrl || texCache.has(n.login)) return;
      texCache.set(n.login, 'loading');
      const img = new Image();
      img.crossOrigin = 'anonymous';
      img.onload = () => { texCache.set(n.login, circleTexture(img, n)); scheduleRefresh(); };
      img.onerror = () => texCache.set(n.login, 'failed');
      img.src = `${n.avatarUrl}${n.avatarUrl.includes('?') ? '&' : '?'}s=96`;
    }

    const isFaded = (n) => focusSet && !focusSet.has(n.id);

    function nodeObject(n) {
      const t = texCache.get(n.login);
      if (!t || typeof t === 'string') return false; // default sphere
      const mat = new THREE.SpriteMaterial({ map: t, transparent: true, depthWrite: false });
      mat.opacity = isFaded(n) ? 0.12 : 1;
      const sprite = new THREE.Sprite(mat);
      const s = highlightSet.has(n.id) ? 16 : isFaded(n) ? 4 : 9;
      sprite.scale.set(s, s, 1);
      return sprite;
    }

    // proximity loader: when the camera gets close, fetch faces for nearby nodes
    setInterval(() => {
      if (!Graph) return;
      const nodes = Graph.graphData().nodes;
      if (!nodes.length) return;
      const cam = Graph.camera().position;
      if (nodes.length <= 400) { nodes.forEach(loadFace); return; } // small view: all faces
      let budget = 60; // per tick, keeps it smooth
      for (const n of nodes) {
        if (n.x === undefined || texCache.has(n.login)) continue;
        const dx = n.x - cam.x, dy = n.y - cam.y, dz = n.z - cam.z;
        if (dx * dx + dy * dy + dz * dz < 220 * 220) {
          loadFace(n);
          if (--budget <= 0) break;
        }
      }
    }, 600);

    // ---- rendering ----

    function render(nodes, links) {
      Graph.graphData({
        nodes,
        links: links.map(([source, target, mutual]) => ({ source, target, mutual })),
      })
        .nodeThreeObject(nodeObject)
        .nodeColor((n) => {
          if (highlightSet.has(n.id)) return '#ffffff';
          if (isFaded(n)) return FADE_COLOR;
          const c = countries[n.country];
          return REGION_COLORS[c?.region] ?? '#7b84ad';
        })
        .nodeVal((n) => (highlightSet.has(n.id) ? 14 : isFaded(n) ? 1 : Math.max(2, 10 - Math.log10(n.rank + 1) * 3)))
        .linkColor((l) => {
          const s = typeof l.source === 'object' ? l.source.id : l.source;
          const t = typeof l.target === 'object' ? l.target.id : l.target;
          if (highlightSet.has(s) && highlightSet.has(t)) return '#ffffff';
          if (focusSet && !(focusSet.has(s) && focusSet.has(t))) return 'rgba(28,33,64,0.4)';
          return l.mutual ? '#8a5cff' : '#1c2140';
        })
        .linkWidth((l) => {
          const s = typeof l.source === 'object' ? l.source.id : l.source;
          const t = typeof l.target === 'object' ? l.target.id : l.target;
          return highlightSet.has(s) && highlightSet.has(t) ? 3.5 : l.mutual ? 1.2 : 0.4;
        })
        .linkOpacity(0.35);
      if (geoMode) applyGeo();
    }

    function applyGeo() {
      for (const n of Graph.graphData().nodes) {
        const c = countries[n.country];
        if (geoMode && c) {
          n.fx = c.lng * 4 + (n.id % 13) - 6;
          n.fy = c.lat * 4 + ((n.id * 7) % 13) - 6;
          n.fz = 0;
        } else {
          n.fx = n.fy = n.fz = undefined;
        }
      }
      try { Graph.d3ReheatSimulation(); } catch { /* engine not ready yet */ }
    }

    // ---- earth backdrop for geo layout ----
    let earthPlane = null;
    function makeEarthPlane() {
      const W = 1440, H = 720;
      const c = document.createElement('canvas');
      c.width = W; c.height = H;
      const ctx = c.getContext('2d');
      ctx.fillStyle = '#0c1024';
      ctx.strokeStyle = 'rgba(46,230,255,0.35)';
      ctx.lineWidth = 1;
      for (const poly of land) {
        const ring = poly[0];
        ctx.beginPath();
        for (let i = 0; i < ring.length; i++) {
          const x = ((ring[i][0] + 180) / 360) * W;
          const y = ((90 - ring[i][1]) / 180) * H;
          i ? ctx.lineTo(x, y) : ctx.moveTo(x, y);
        }
        ctx.closePath();
        ctx.fill();
        ctx.stroke();
      }
      const tex = new THREE.CanvasTexture(c);
      tex.colorSpace = THREE.SRGBColorSpace;
      const mesh = new THREE.Mesh(
        new THREE.PlaneGeometry(360 * 4, 180 * 4),
        new THREE.MeshBasicMaterial({ map: tex, transparent: true, opacity: 0.45, depthWrite: false })
      );
      mesh.position.z = -10;
      mesh.visible = false;
      return mesh;
    }

    // ---- filters ----
    const filterCountries = new Set();
    let rankCap = 100;
    let minFollowers = 100;
    let repoMembers = null; // login set when repo filter active
    let repoName = null;
    let REPO_INDEX = null;
    let hideLoners = false;
    const hiddenSet = new Set();
    let hideHops = 0;

    function filteredNodes() {
      let nodes = DATA.nodes.filter((n) => !hiddenSet.has(n.id));
      if (repoMembers) return nodes.filter((n) => repoMembers.has(n.login)); // repo view: exact member set
      if (filterCountries.size) nodes = nodes.filter((n) => filterCountries.has(n.country));
      if (minFollowers > 0) nodes = nodes.filter((n) => (n.followers ?? 0) >= minFollowers);
      return nodes.slice(0, rankCap); // nodes are pre-sorted by rank
    }

    function updateUnhideBtn() {
      const btn = document.getElementById('net-unhide');
      btn.classList.toggle('hidden', hiddenSet.size === 0);
      btn.textContent = `unhide ${hiddenSet.size}`;
    }

    function fullView() {
      // repo view keeps its member set lit up
      highlightSet = repoMembers
        ? new Set(DATA.nodes.filter((n) => repoMembers.has(n.login)).map((n) => n.id))
        : new Set();
      focusSet = null;
      document.getElementById('stats-panel').classList.add('hidden');
      let nodes = filteredNodes();
      let keep = new Set(nodes.map((n) => n.id));
      let links = DATA.links.filter(([a, b]) => keep.has(a) && keep.has(b));
      if (hideLoners) {
        const linked = new Set();
        for (const [a, b] of links) { linked.add(a); linked.add(b); }
        nodes = nodes.filter((n) => linked.has(n.id));
        keep = new Set(nodes.map((n) => n.id));
        links = links.filter(([a, b]) => keep.has(a) && keep.has(b));
      }
      render(nodes, links);
      const filters = [
        repoName ? `contributors to ${repoName}` : null,
        !repoName && filterCountries.size ? [...filterCountries].map((s) => s.replace(/_/g, ' ')).join(' + ') : null,
        !repoName && minFollowers > 0 ? `≥${minFollowers.toLocaleString()} followers` : null,
        hideLoners ? 'unlinked hidden' : null,
        hiddenSet.size ? `${hiddenSet.size} removed` : null,
      ].filter(Boolean).join(' · ');
      status.textContent = `showing ${nodes.length.toLocaleString()} of ${DATA.nodes.length.toLocaleString()} connected devs${filters ? ` (${filters})` : ''} · ${links.length.toLocaleString()} edges · purple links = mutual follows · zoom in for faces · right-click removes`;
    }

    let vouchData = null;
    let trustData = null;
    async function showStats(node, directCount) {
      const panel = document.getElementById('stats-panel');
      const flag = flagEmoji(node.country);
      if (!vouchData) vouchData = await fetch('/data/vouchrank.json').then((r) => r.json()).catch(() => ({ users: {} }));
      if (!trustData) trustData = await fetch('/data/trust.json').then((r) => r.json()).catch(() => ({ users: {} }));
      const vr = vouchData.users[node.login];
      document.getElementById('stats-avatar').src = node.avatarUrl ? `${node.avatarUrl}${node.avatarUrl.includes('?') ? '&' : '?'}s=128` : '';
      document.getElementById('stats-body').innerHTML = `
        <div class="sp-login">${node.login} ${flag ?? ''}</div>
        <div class="sp-row"><span>global rank</span><b>#${node.rank.toLocaleString()}</b></div>
        <div class="sp-row"><span>contributions</span><b>${node.contributions.toLocaleString()}</b></div>
        ${node.followers != null ? `<div class="sp-row"><span>followers</span><b>${node.followers.toLocaleString()}</b></div>` : ''}
        <div class="sp-row"><span>connections here</span><b>${directCount}</b></div>
        ${vr ? `<div class="sp-row"><span>vouchrank</span><b>${vr[1]} <span style="color:var(--muted)">(#${vr[0]})</span></b></div>` : ''}
        ${trustData?.users?.[node.login] ? `<div class="sp-row"><span>trustscore</span><b>TR${Math.round(trustData.users[node.login][1] / 100)} · ${trustData.users[node.login][1]}</b></div>` : ''}
        <div class="sp-links">
          ${node.rank <= 1000 ? `<a href="/u/${node.login}">rank card</a> · ` : ''}
          <a href="/vouchrank?u=${node.login}">vouchrank</a> ·
          <a href="https://github.com/${node.login}" target="_blank" rel="noopener">github ↗</a>
        </div>`;
      panel.classList.remove('hidden');
    }

    function egoView(login) {
      const node = byLogin.get(login.toLowerCase());
      if (!node) { status.textContent = `${login} isn't in the crawled network (yet)`; return; }
      const dist = egoSet(node.id);
      const keep = new Set(dist.keys());
      highlightSet = new Set([node.id]);
      focusSet = null;
      const links = DATA.links.filter(([a, b]) => keep.has(a) && keep.has(b));
      const nodes = DATA.nodes.filter((n) => keep.has(n.id));
      render(nodes, links);
      nodes.filter((n) => dist.get(n.id) <= 1).forEach(loadFace);
      const directCount = [...dist.values()].filter((d) => d === 1).length;
      status.textContent = `${node.login}: ${directCount} direct connections, ${keep.size - 1} within 2 hops`;
      showStats(node, directCount);
      setTimeout(() => {
        try { Graph.zoomToFit(1000, 60, (n) => dist.get(n.id) <= 1); } catch {}
      }, 1600);
    }

    async function loadRepoIndex() {
      if (!REPO_INDEX) {
        REPO_INDEX = await fetch('/data/repo_members.json').then((r) => r.json()).catch(() => ({}));
        const dl = document.getElementById('repo-list');
        for (const repo of Object.keys(REPO_INDEX)) {
          const o = document.createElement('option');
          o.value = repo;
          dl.appendChild(o);
        }
      }
      return REPO_INDEX;
    }

    function repoView(repo) {
      const members = REPO_INDEX?.[repo];
      if (!members) { status.textContent = `no contributor data for ${repo}`; return; }
      repoName = repo;
      repoMembers = new Set(members);
      fullView();
      Graph.graphData().nodes.forEach(loadFace);
      setTimeout(() => { try { Graph.zoomToFit(1000, 80); } catch {} }, 1500);
    }

    function bfsDist(srcId, maxDepth = 6) {
      const dist = new Map([[srcId, 0]]);
      let q = [srcId];
      for (let d = 1; d <= maxDepth && q.length; d++) {
        const next = [];
        for (const n of q) for (const m of adj.get(n)) {
          if (!dist.has(m)) { dist.set(m, d); next.push(m); }
        }
        q = next;
      }
      return dist;
    }

    function pathView(fromLogin, toLogin) {
      const a = byLogin.get(fromLogin.toLowerCase());
      const b = byLogin.get(toLogin.toLowerCase());
      if (!a || !b) { status.textContent = 'both users need to be in the network'; return; }
      const dA = bfsDist(a.id);
      if (!dA.has(b.id)) { status.textContent = `${a.login} and ${b.login} aren't connected (in crawled data)`; return; }
      const D = dA.get(b.id);
      const dB = bfsDist(b.id, D);
      // every node lying on ANY shortest path: dA(n) + dB(n) === D
      const onPath = new Set();
      for (const [id, da] of dA) {
        if (dB.has(id) && da + dB.get(id) === D) onPath.add(id);
      }
      const canonical = bfsPath(a.id, b.id) ?? [];
      const keep = new Set(onPath);
      for (const id of onPath) for (const m of adj.get(id)) keep.add(m);
      highlightSet = onPath;
      focusSet = onPath; // everything off the shortest routes fades into context
      const links = DATA.links.filter(([x, y]) => keep.has(x) && keep.has(y));
      const nodes = DATA.nodes.filter((n) => keep.has(n.id));
      render(nodes, links);
      nodes.filter((n) => onPath.has(n.id)).forEach(loadFace);
      const names = canonical.map((id) => DATA.nodes.find((n) => n.id === id)?.login).join(' → ');
      const middlemen = onPath.size - 2;
      status.textContent =
        `${D} degree${D > 1 ? 's' : ''} apart · ${middlemen > canonical.length - 2 ? `${middlemen} devs sit on shortest routes` : 'one route'} · e.g. ${names}`;
      // reorient the camera onto the shortest-path subgraph once the layout settles
      setTimeout(() => {
        try { Graph.zoomToFit(1200, 90, (n) => onPath.has(n.id)); } catch {}
      }, 1800);
    }

    async function init() {
      DATA = await fetch('/data/network.json').then((r) => r.json());
      DATA.nodes.forEach((n) => byLogin.set(n.login.toLowerCase(), n));
      buildAdj();
      if (DATA.simulated) document.getElementById('net-sim').classList.remove('hidden');
      document.getElementById('net-meta').textContent =
        `crawled ${DATA.crawledUsers.toLocaleString()} profiles so far — updated ${new Date(DATA.generatedAt).toLocaleDateString()}.`;

      Graph = new ForceGraph3D(el)
        .backgroundColor('#06070e')
        .showNavInfo(false)
        .nodeLabel((n) => `<div style="background:#0c0e1a;border:1px solid #1c2140;border-radius:8px;padding:6px 10px">
            <img src="${n.avatarUrl ? n.avatarUrl + (n.avatarUrl.includes('?') ? '&' : '?') + 's=48' : ''}" width="24" height="24" style="border-radius:50%;vertical-align:middle"/>
            <b style="color:#e8ecff"> ${n.login}</b> <span style="color:#7b84ad">#${n.rank} · ${n.country?.replace(/_/g, ' ') ?? ''}</span></div>`)
        .onNodeClick((n) => {
          document.getElementById('net-user').value = n.login;
          egoView(n.login);
        })
        .onNodeRightClick((n) => {
          const zone = egoSet(n.id, hideHops, 2000);
          for (const id of zone.keys()) hiddenSet.add(id);
          updateUnhideBtn();
          fullView();
        })
        .width(el.clientWidth)
        .height(el.clientHeight);

      earthPlane = makeEarthPlane();
      Graph.scene().add(earthPlane);

      const params = new URLSearchParams(location.search);
      const u = params.get('u');
      const pathTo = params.get('path');
      const repo = params.get('repo');
      if (repo) {
        await loadRepoIndex();
        document.getElementById('net-repo').value = repo;
        repoView(repo);
      } else if (u && pathTo && byLogin.has(u.toLowerCase()) && byLogin.has(pathTo.toLowerCase())) {
        document.getElementById('net-user').value = u;
        document.getElementById('net-path').value = pathTo;
        pathView(u, pathTo);
      } else if (u && byLogin.has(u.toLowerCase())) {
        document.getElementById('net-user').value = u;
        egoView(u);
      } else {
        fullView();
      }
      loadRepoIndex(); // populate the datalist in the background
    }

    document.getElementById('net-user').addEventListener('change', (e) => {
      const v = e.target.value.trim();
      if (v) egoView(v);
    });
    document.getElementById('net-path').addEventListener('change', (e) => {
      const from = document.getElementById('net-user').value.trim();
      const to = e.target.value.trim();
      if (from && to) pathView(from, to);
    });
    document.getElementById('net-geo').addEventListener('click', (e) => {
      geoMode = !geoMode;
      e.target.classList.toggle('active', geoMode);
      if (earthPlane) earthPlane.visible = geoMode;
      applyGeo();
    });
    document.getElementById('net-reset').addEventListener('click', () => {
      document.getElementById('net-user').value = '';
      document.getElementById('net-path').value = '';
      document.getElementById('net-country').value = '';
      document.getElementById('net-repo').value = '';
      repoName = null;
      repoMembers = null;
      filterCountries.clear();
      hiddenSet.clear();
      updateUnhideBtn();
      renderChips();
      fullView();
    });
    document.getElementById('net-loners').addEventListener('click', (e) => {
      hideLoners = !hideLoners;
      e.target.classList.toggle('active', hideLoners);
      fullView();
    });
    document.getElementById('hide-hops').addEventListener('change', (e) => {
      hideHops = Number(e.target.value);
    });
    document.getElementById('net-unhide').addEventListener('click', () => {
      hiddenSet.clear();
      updateUnhideBtn();
      fullView();
    });

    // ---- filter wiring ----
    const slugByTitle = new Map(Object.entries(countries).map(([slug, c]) => [c.title.toLowerCase(), slug]));
    const datalist = document.getElementById('country-list');
    for (const c of Object.values(countries)) {
      const o = document.createElement('option');
      o.value = c.title;
      datalist.appendChild(o);
    }

    function renderChips() {
      document.getElementById('country-chips').innerHTML = [...filterCountries]
        .map((s) => `<button class="chip chip-x" data-slug="${s}">${countries[s]?.title ?? s} ×</button>`)
        .join(' ');
      document.querySelectorAll('.chip-x').forEach((b) =>
        b.addEventListener('click', () => { filterCountries.delete(b.dataset.slug); renderChips(); fullView(); })
      );
    }

    document.getElementById('net-country').addEventListener('change', (e) => {
      const slug = slugByTitle.get(e.target.value.trim().toLowerCase());
      if (slug) {
        filterCountries.add(slug);
        e.target.value = '';
        renderChips();
        fullView();
      }
    });

    const debounce = (fn, ms) => { let t; return (...a) => { clearTimeout(t); t = setTimeout(() => fn(...a), ms); }; };
    document.getElementById('rank-cap').addEventListener('input', debounce((e) => {
      rankCap = Math.max(10, Number(e.target.value) || 100);
      fullView();
    }, 350));
    document.getElementById('min-followers').addEventListener('input', debounce((e) => {
      minFollowers = Math.max(0, Number(e.target.value) || 0);
      fullView();
    }, 350));
    document.getElementById('net-repo').addEventListener('change', async (e) => {
      const repo = e.target.value.trim();
      if (!repo) { repoName = null; repoMembers = null; fullView(); return; }
      await loadRepoIndex();
      repoView(repo);
    });
    document.getElementById('stats-close').addEventListener('click', () =>
      document.getElementById('stats-panel').classList.add('hidden')
    );

    init();
  </script>

