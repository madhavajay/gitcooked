      border: 2px solid var(--violet); box-shadow: 0 0 16px #8a5cff55;
    }
    #stats-panel .sp-login { font-weight: 700; font-size: 16px; margin: 8px 0 10px; }
    #stats-panel .sp-row {
      display: flex; justify-content: space-between; font-size: 12px;
      color: var(--muted); padding: 3px 0; border-bottom: 1px solid #14182e;
    }
    #stats-panel .sp-row b { color: var(--cyan); font-family: ui-monospace, Menlo, monospace; }
    #stats-panel .sp-links { margin-top: 10px; font-size: 12px; }
    .num-box {
